# 範例不是可用憑證；啟動前由私有環境提供，不會自動載入 .env。
DB_URL=jdbc:mysql://127.0.0.1:13306/figura_shop_demo?serverTimezone=Asia/Taipei
DB_USERNAME=shop_demo
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=17379
REDIS_PASSWORD=
JWT_SECRET=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=19092
# 僅 loopback HTTP 演練 false；真正 HTTPS 保持 true。
AUTH_COOKIE_SECURE=false

# 僅隔離 demo 初始化／Compose 使用；不會重設既有帳號。
MYSQL_ROOT_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# 只在隔離展示啟用，沒有真實收款；簽章密鑰不可放VITE_*。
MOCK_PAYMENTS_ENABLED=true
MOCK_PAYMENT_WEBHOOK_SECRET=
MOCK_FULFILLMENT_ENABLED=true

MOCK_REFUNDS_ENABLED=true

MOCK_RETURNS_ENABLED=true

# 私有SeaweedFS S3，圖片傳輸經後端，不放VITE_*。
SHOP_IMAGES_ENABLED=true
SHOP_IMAGES_ENDPOINT=http://127.0.0.1:18333
SHOP_IMAGES_ACCESS_KEY=
SHOP_IMAGES_SECRET_KEY=
SHOP_IMAGES_BUCKET=figura-images
SHOP_IMAGES_INIT_BUCKET=true

# Notifications capture is transactional; delivery is local MOCK only and explicitly opt-in.
MOCK_NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_WORKER_ENABLED=false
NOTIFICATIONS_DELAY_MS=30000
