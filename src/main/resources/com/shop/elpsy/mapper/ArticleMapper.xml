<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.elpsy.mapper.ArticleMapper">
    <select id="list" resultType="com.shop.elpsy.pojo.Article">
        select * from article
        <where>
            <if test="categoryId!=null">
                category_id = #{categoryId}
            </if>
            <if test="state!=null">
                and state = #{state}
            </if>
        and create_user = #{userId}
        </where>
    </select>
</mapper>