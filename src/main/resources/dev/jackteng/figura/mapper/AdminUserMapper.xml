<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.jackteng.figura.mapper.AdminUserMapper">
    <resultMap id="userRolePermissionMap" type="dev.jackteng.figura.pojo.User">
        <id property="id" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="email" column="email"/>
        <result property="telephone" column="telephone"/>
        <result property="userPic" column="user_pic"/>
        <result property="lastLoginTime" column="lastLogin_time"/>
        <result property="createdTime" column="created_time"/>
        <result property="modifiedTime" column="modified_time"/>
        <result property="isStop" column="is_stop"/>
        <!-- Map other User properties -->
            <collection property="role" ofType="dev.jackteng.figura.pojo.Role">
                <id property="id" column="role_id"/>
                <result property="name" column="role_name"/>
                <result property="description" column="role_description"/>
                <!-- Map other Permission properties -->
            </collection>
        <collection property="permissions" ofType="dev.jackteng.figura.pojo.Permission">
                <id property="id" column="permission_id"/>
                <result property="name" column="permission_name"/>
                <result property="parentId" column="permission_parent_id"/>
                <result property="level" column="level"/>
                <result property="url" column="url"/>
                <result property="method" column="method"/>
                <result property="adminRouter" column="admin_router"/>
                <result property="code" column="permission_code"/>
                <!-- Map other Permission properties -->
            </collection>
    </resultMap>

    <resultMap id="userRoleMap" type="dev.jackteng.figura.pojo.User">
        <id property="id" column="user_id"/>
        <result property="username" column="username"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="email" column="email"/>
        <result property="telephone" column="telephone"/>
        <result property="userPic" column="user_pic"/>
        <result property="lastLoginTime" column="lastLogin_time"/>
        <result property="createdTime" column="created_time"/>
        <result property="modifiedTime" column="modified_time"/>
        <result property="isStop" column="is_stop"/>

        <collection property="role" ofType="dev.jackteng.figura.pojo.Role">
            <id property="id" column="role_id"/>
            <result property="name" column="role_name"/>
            <result property="description" column="role_description"/>

<!--            <collection property="permission" ofType="dev.jackteng.figura.pojo.Permission">-->
<!--                <id property="id" column="permission_id"/>-->
<!--                <result property="name" column="permission_name"/>-->
<!--                &lt;!&ndash; 其他权限字段 &ndash;&gt;-->
<!--            </collection>-->
        </collection>
    </resultMap>
    <select id="findAllByUserName" resultMap="userRolePermissionMap">
        SELECT
            u.id as "user_id",u.username, u.password,u.first_name, u.last_name,u.email,
            u.telephone, u.user_pic,u.lastLogin_time,u.is_stop,r.id as "role_id",r.name as "role_name",r.description as "role_description",
            p.id as "permission_id", p.name as "permission_name",p.parent_id as "permission_parent_id",
            p.level,p.url,p.method,p.admin_router,p.code as permission_code
        FROM
            user u
                LEFT JOIN user_role ur ON u.id = ur.user_id
                LEFT JOIN role r ON ur.role_id = r.id
                LEFT JOIN role_permission rp ON r.id = rp.role_id
                LEFT JOIN permissions_backend p ON rp.permission_id = p.id
        WHERE u.username = #{username}
    </select>
    <select id="findAllUser" resultMap="userRoleMap">
        select u.id as user_id, u.username, u.first_name, u.last_name, u.email, u.telephone, u.user_pic,
        u.lastLogin_time, u.created_time, u.modified_time, u.is_stop,
        r.id as role_id, r.name as role_name, r.description as role_description
        from user u
        left join user_role ur on u.id = ur.user_id
        left join role r on ur.role_id = r.id
        <where>
            <if test="username != null and username.trim().length() > 0">
                and u.username = #{username}
            </if>
            <if test="role != null and role.length > 0">
                and u.id in (
                select ur.user_id
                from user_role ur
                where ur.role_id in
                <foreach item="roleId" collection="role" open="(" separator="," close=")">
                    #{roleId}
                </foreach>
                group by ur.user_id
                having count(distinct ur.role_id) = #{roleCount}
                )
            </if>
            <if test="isStop != null and isStop.trim().length() > 0">
                and u.is_stop = #{isStop}
            </if>
        </where>
    </select>

